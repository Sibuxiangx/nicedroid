# nicedroid under systemd.
#
# Adapted from `podman generate systemd --new --name nicedroid`. The --new form
# is kept deliberately: the unit runs `podman run` on every start rather than
# restarting a saved container, so redeploying is "replace the image, restart the
# unit" with no stale container state to clean up.
#
# Install to /etc/systemd/system/container-nicedroid.service, then:
#   systemctl daemon-reload && systemctl enable --now container-nicedroid
#
# Assumes /root/work/nicedroid/ holds data/ (the SQLite file) and nicedroid.env
# (credentials, mode 0600). Adjust the paths and the env file to taste.

[Unit]
Description=nicedroid gateway
Documentation=https://github.com/Sibuxiangx/nicedroid
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--sdnotify=conmon \
	--replace \
	-d \
	--name nicedroid \
	-p 127.0.0.1:8020:3000 \
	-v /root/work/nicedroid/data:/data \
	--env-file /root/work/nicedroid/nicedroid.env \
	localhost/nicedroid:latest
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
